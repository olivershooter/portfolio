{
	# Request counts, status codes and durations, served on :9180 below
	metrics
}

# Coolify's proxy handles the domain and HTTPS; this only serves the site on port 80
:80 {
	encode zstd gzip

	# For the Docker healthcheck and the pipeline's post-deploy check
	handle /api/health {
		header Content-Type application/json
		respond `{"status":"ok"}` 200
	}

	handle {
		root * /srv
		# File names don't change between deploys, so browsers must check before reusing a copy
		header Cache-Control "no-cache"
		# One-page site: unknown paths get the page, like the old React router's redirect
		try_files {path} /index.html
		file_server
	}
}

# Prometheus scrapes this over the Docker network; Coolify only routes port 80 to the internet
:9180 {
	metrics
}
